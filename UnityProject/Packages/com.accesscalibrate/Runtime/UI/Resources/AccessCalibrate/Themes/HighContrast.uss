/* High Contrast: black background, white text and lines, yellow accent. Overrides tokens only. */
.ac-root {
    --ac-bg-image: none;
    --ac-bg-top: #000000;
    --ac-bg-bottom: #000000;
    --ac-bg-overlay: rgba(0, 0, 0, 0);
    --ac-scrim: rgba(0, 0, 0, 0.80);
    --ac-text: #FFFFFF;
    --ac-text-body: #FFFFFF;
    --ac-text-soft: #FFFFFF;
    --ac-text-dim: #FFFFFF;
    --ac-text-muted: #FFFFFF;
    --ac-text-faint: #FFFFFF;
    --ac-line: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-line-strong: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-line-dialog: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-control-border: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-key-border: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-surface-card: #000000;
    --ac-surface-control: #000000;
    --ac-surface-sunken: #000000;
    --ac-surface-panel: #000000;
    --ac-surface-dialog: #000000;
    --ac-surface-arena: #000000;
    --ac-accent: #FFD60A;
    --ac-on-accent: #000000;
    --ac-accent-glow: rgba(255, 255, 255, 0.70);
    --ac-accent-halo: rgba(255, 214, 10, 0.06);
    --ac-accent-glow-soft: rgba(255, 255, 255, 0.70);
    --ac-primary: #FFFFFF;
    --ac-on-primary: #000000;
    --ac-shadow: rgba(0, 0, 0, 0.50);
    --ac-track: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-track-soft: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-track-slider: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-track-value: #FFFFFF;
    --ac-track-marker: #FFFFFF;
    --ac-step-done: #FFFFFF;
    --ac-step-dot: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-step-line: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-ring-outer: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-ring-inner: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-ring-dot: #000000;
    --ac-tick-lit: #FFFFFF;
    --ac-crosshair: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-toggle-off-border: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-toggle-off-knob: #FFFFFF;
    --ac-icon: #FFFFFF;
    --ac-draw-body: #000000;
    --ac-draw-body-2: #000000;
    --ac-draw-fill: #000000;
    --ac-draw-fill-soft: #000000;
    --ac-draw-fill-strong: #000000;
    --ac-draw-stroke: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-draw-stroke-key: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-draw-stroke-frame: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-draw-stroke-mouse: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-draw-stroke-soft: #B2B2B2;   /* rgba(255, 255, 255, 0.70) */
    --ac-draw-stroke-faint: #000000;
    --ac-draw-label: #FFFFFF;
    --ac-draw-key-label: #FFFFFF;
    --ac-draw-on-highlight: #000000;
}
