<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- UI v2 (Docs/design-v2). Styles: CalibrationViewStyle.uss + theme USS. Reference size 1280×720.
         The view (UIToolkitCalibrationView) fills the pages from code. -->
    <ui:VisualElement name="ac-root" class="ac-root">
        <ui:VisualElement name="ac-screen" class="ac-screen">
            <ui:VisualElement name="ac-topbar" class="ac-topbar">
                <ui:VisualElement class="ac-top-left">
                    <ui:Label name="ac-top-title" class="ac-top-title" />
                </ui:VisualElement>
                <ui:VisualElement class="ac-top-center">
                    <ui:VisualElement name="ac-steps" class="ac-steps" />
                </ui:VisualElement>
                <ui:VisualElement name="ac-top-right" class="ac-top-right" />
            </ui:VisualElement>

            <ui:VisualElement name="ac-main" class="ac-main">
                <ui:VisualElement name="ac-page-welcome" class="ac-page ac-welcome" />
                <ui:VisualElement name="ac-page-check" class="ac-page ac-check">
                    <ui:VisualElement name="ac-col-left" class="ac-col-left" />
                    <ui:VisualElement name="ac-col-center" class="ac-col-center" />
                    <ui:VisualElement name="ac-col-right" class="ac-col-right" />
                </ui:VisualElement>
                <ui:VisualElement name="ac-page-suggest" class="ac-page ac-suggest" />
                <ui:VisualElement name="ac-page-nochange" class="ac-page ac-nochange" />
                <ui:VisualElement name="ac-page-summary" class="ac-page ac-summary" />
            </ui:VisualElement>

            <!-- Device picker: over the top bar and the page, under the bottom bar -->
            <ui:VisualElement name="ac-dialog-layer" class="ac-dialog-layer" />

            <ui:VisualElement name="ac-bottombar" class="ac-bottombar">
                <ui:VisualElement name="ac-hints" class="ac-hints" />
                <ui:VisualElement name="ac-bottom-right" class="ac-bottom-right" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
